PORT=3006
# Optional: mirror sales to Google Sheets (see docs/google-sheets-setup.md)
# SHEETS_URL=https://script.google.com/macros/s/XXXX/exec
# SHEETS_TOKEN=same-value-as-the-TOKEN-script-property
# Optional: folder for users/sales/config JSON files (point it to a persistent volume in production)
# DATA_DIR=/data
JWT_SECRET=change-me-to-a-long-random-string
# The account registered with this email gets the admin role
ADMIN_EMAIL=you@example.com
